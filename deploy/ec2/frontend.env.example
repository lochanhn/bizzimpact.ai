NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NODE_OPTIONS=--max-old-space-size=160
SITE_URL=https://bizzimpact.3-92-95-188.sslip.io
NEXT_PUBLIC_SUPABASE_URL=https://zqtndgqyaibgrholekxu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
DISCOVERY_BACKEND_URL=http://bizzimpact-backend:8001
OPENROUTER_ENABLED=false
LIVE_WEB_ENABLED=false

# ── AI check-up (/start): Discover → Review → Integrate engines (website/lib) ──
# Signs check-in tokens so only owners who received a plan can report results. Required for check-ins.
PLAN_SIGNING_SECRET=GENERATE_WITH_openssl_rand_-hex_32
# Days after a plan before check-ins open (product default 14; use 0 for a live judging demo).
OUTCOME_MIN_DAYS=14
# Runtime JSON (spend ledger, check-ins, new live finds). Falls back to /tmp if not writable.
DATA_DIR=/app/data/runtime
# Optional AI features in the website (AI fallback for unusual wording, live web search for gaps).
# Pre-run live finds are bundled, so the demo works with these disabled.
# If enabled, use a SEPARATE OpenRouter key with a small provider-side credit limit (e.g. $3):
# the app cap below is per container, the provider limit is the real hard stop.
# OPENROUTER_API_KEY=
# OPENROUTER_ENABLED=true
# LIVE_WEB_ENABLED=true
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# AI_BUDGET_USD=3
