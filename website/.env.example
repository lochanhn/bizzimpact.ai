# Public connection settings, not a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set this to your actual HTTPS domain before production signup.
SITE_URL=http://localhost:3000
# Live AI (problem interpretation fallback) and live web discovery. Server-side only.
# Put the real key in .env.local (git-ignored). Never use a NEXT_PUBLIC_ prefix for it.
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false
LIVE_WEB_ENABLED=false
# Optional: model and app-level spend cap in USD (calls stop before the cap).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
AI_BUDGET_USD=20
# Signs check-in tokens (server-side only). Generate with: openssl rand -hex 32
PLAN_SIGNING_SECRET=
# Days after a plan before owners can report results (product default 14).
OUTCOME_MIN_DAYS=14
