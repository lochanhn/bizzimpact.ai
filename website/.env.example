# Public connection settings, not a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set this to your actual HTTPS domain before production signup.
SITE_URL=http://localhost:3000
# Live AI/search remain disabled. No API key is required for current features.
OPENROUTER_ENABLED=false
LIVE_WEB_ENABLED=false

# Server-side proxy to the persistent Python discovery worker.
DISCOVERY_BACKEND_URL=http://127.0.0.1:8001
